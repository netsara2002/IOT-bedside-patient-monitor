#include <Wire.h>
#include "MAX30105.h" // This library works for MAX30102 as well
#include "heartRate.h"

MAX30105 particleSensor;

// --- State Variables ---
bool isMeasuring = false;
bool fingerPresent = false;
unsigned long measurementStartTime = 0;

// --- BPM Variables ---
long lastBeat = 0;
float bpmSum = 0;
int bpmCount = 0;

// IR value threshold for finger detection (Adjust if necessary)
const long FINGER_THRESHOLD = 50000; 

void setup() {
  Serial.begin(115200);
  Serial.println("Initializing MAX30102...");

  // Initialize sensor on standard ESP32 I2C pins (SDA=21, SCL=22)
  if (!particleSensor.begin(Wire, I2C_SPEED_FAST)) {
    Serial.println("MAX30102 was not found. Please check wiring and power.");
    while (1); // Halt execution
  }

  // Configure sensor with default settings
  particleSensor.setup(); 
  
  // Turn Red LED to low to indicate sensor is running, turn off Green LED
  particleSensor.setPulseAmplitudeRed(0x0A); 
  particleSensor.setPulseAmplitudeGreen(0); 
  
  Serial.println("Waiting for finger...");
}

void loop() {
  long irValue = particleSensor.getIR();

  // Check if the finger is OFF the sensor
  if (irValue < FINGER_THRESHOLD) {
    if (fingerPresent) {
      Serial.println("--- Finger removed. Waiting for finger... ---");
      fingerPresent = false;
      isMeasuring = false;
    }
    delay(10); // Small delay to prevent serial spam
  } 
  
  // Check if the finger is ON the sensor
  else {
    if (!fingerPresent) {
      Serial.println("Finger detected! Calculating for 5 seconds...");
      fingerPresent = true;
      isMeasuring = true;
      
      // Reset variables for the new measurement cycle
      measurementStartTime = millis();
      bpmSum = 0;
      bpmCount = 0;
      lastBeat = millis(); // Reset beat timer
    }

    if (isMeasuring) {
      // Check for a heartbeat using the SparkFun algorithm
      if (checkForBeat(irValue) == true) {
        long delta = millis() - lastBeat;
        lastBeat = millis();

        float beatsPerMinute = 60 / (delta / 1000.0);

        // Filter out unrealistic BPM values (noise)
        if (beatsPerMinute < 255 && beatsPerMinute > 20) {
          bpmSum += beatsPerMinute;
          bpmCount++;
        }
      }

      // Check if 5 seconds (5000 milliseconds) have passed
      if (millis() - measurementStartTime >= 5000) {
        if (bpmCount > 0) {
          float averageBPM = bpmSum / bpmCount;
          Serial.print(">>> 5-Second Average BPM: ");
          Serial.println(averageBPM);
        } else {
          Serial.println(">>> Measurement failed. Please keep your finger still.");
        }

        // Reset variables to start the next 5-second cycle immediately
        measurementStartTime = millis();
        bpmSum = 0;
        bpmCount = 0;
        Serial.println("Calculating for next 5 seconds...");
      }
    }
  }
}
